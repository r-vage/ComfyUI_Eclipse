      "title": "TRY AN INSERT / Preview image priorities",
      "properties": {},
      "widgets_values": [
        "Right-click the getter in group 1 > Sync chain > Edit shared chain.\n\nInsert demo_gold between demo_red and demo_green, then Apply.\n\nGroups 1, 3 and 4 gain GOLD. Their existing wires stay in place; wired switches gain a trailing connection. Group 2 starts at GREEN and stays unchanged.\n\nMute Set_demo_red and Run: groups 1 and 3 show GOLD, group 2 shows GREEN. The comparison chain is separate.\n\nCancel changes nothing. Ctrl+Z undoes the shared edit in one step."
      ],
      "widgets_values_named": {
        "text": "Right-click the getter in group 1 > Sync chain > Edit shared chain.\n\nInsert demo_gold between demo_red and demo_green, then Apply.\n\nGroups 1, 3 and 4 gain GOLD. Their existing wires stay in place; wired switches gain a trailing connection. Group 2 starts at GREEN and stays unchanged.\n\nMute Set_demo_red and Run: groups 1 and 3 show GOLD, group 2 shows GREEN. The comparison chain is separate.\n\nCancel changes nothing. Ctrl+Z undoes the shared edit in one step."
      },
      "color": "#432",
      "bgcolor": "#653"
    },
