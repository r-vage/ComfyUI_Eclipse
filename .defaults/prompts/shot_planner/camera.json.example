  "compositions": {
    "center": "Subject centered with balanced safe margins around the requested body region; keep background space modest",
    "left": "Subject slightly left of center with a little breathing room to the right; keep safe margins around the requested body region and avoid pushing the subject against the left edge",
    "right": "Subject slightly right of center with a little breathing room to the left; keep safe margins around the requested body region and avoid pushing the subject against the right edge"
