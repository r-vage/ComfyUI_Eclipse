      ]
    }
  },
  "orientations": {
    "front": "Frontal view; face and torso face the camera",
    "left_three_quarter": "Front-left three-quarter view; face and torso turn together diagonally left",
    "right_three_quarter": "Front-right three-quarter view; face and torso turn together diagonally right",
    "left_profile": "Left-side profile; head and torso stay side-on, gaze continues off-frame left",
