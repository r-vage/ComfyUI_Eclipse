  "body_overrides": {
    "lying": {
      "distances": {
        "close": "Close portrait of the lying subject, complete head and shoulders inside the frame, retain the horizontal supported posture",
        "mid": "Medium photograph of the lying subject, complete head and torso to the waist inside the frame, include any arms described as extended",
        "wide": "Wide full-body photograph of the lying subject, head to toes and both feet visible with space around the horizontal figure"
      },
      "cameras": {
        "eye": "Camera beside the support, level with the lying subject's face; keep the lens above the support surface",
        "raised": "Camera slightly above the lying subject's face and support, looking gently downward",
        "overhead": "Camera high above the horizontal subject, looking down toward the support",
        "lowered": "Low oblique camera beside the support, lens just above its surface, looking along the body without obstruction",
        "ground": "Camera close to the floor beside the support; elevate the lens enough to keep the face and torso visible above its edge",
        "table": "Camera at a low bedside-table height beside the lying subject, looking gently down toward the face"
      },
      "orientations": {
        "front": "View toward the front of the face and torso; move the camera around or above the support rather than turning the body upright",
        "left_three_quarter": "Oblique view from the subject's front-left side while preserving the supported lying pose",
        "right_three_quarter": "Oblique view from the subject's front-right side while preserving the supported lying pose",
        "left_profile": "View from the subject's left side emphasizing the facial profile; keep the body in its supported lying pose",
        "right_profile": "View from the subject's right side emphasizing the facial profile; keep the body in its supported lying pose"
      }
    }
  }
}
