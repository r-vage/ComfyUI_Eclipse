{
  "schema_version": 1,
  "categories": {
    "abstract_symbols": "Graphic or symbolic shapes that represent concepts rather than physical scene objects.",
    "actions": "Dynamic activities, gestures, or interactions performed by a subject that are not poses or sexual acts.",
